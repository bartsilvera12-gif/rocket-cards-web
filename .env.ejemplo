# Copiá este archivo como .env y completá los valores.
# .env está en .gitignore: no se sube al repo ni se publica.

# ── Conexión a Supabase ──────────────────────────────────────────────────
#
# TIENE que ser conexión directa o pooler en modo SESIÓN (puerto 5432).
# El pooler en modo transacción (puerto 6543) reparte cada consulta por una
# conexión distinta y NO soporta LISTEN/NOTIFY: con esa cadena el servidor
# arranca, pero nunca se entera de los cambios y la tienda queda congelada
# mostrando el catálogo del arranque.
#
# En el panel de Supabase: Project Settings → Database → Connection string.
#
#   Session pooler (lo normal):
#     postgresql://rocketcards_app.<ref>:CLAVE@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   Conexión directa (necesita IPv6, o el add-on de IPv4):
#     postgresql://rocketcards_app:CLAVE@db.<ref>.supabase.co:5432/postgres
#
# Ojo con el usuario: por el pooler lleva el ref del proyecto pegado con un
# punto (rocketcards_app.abcdefgh...), en la conexión directa no.
#
# CLAVE es la que le pusiste al rol con:
#   ALTER ROLE rocketcards_app PASSWORD '...';
DATABASE_URL=postgresql://rocketcards_app.REF:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Servidor ─────────────────────────────────────────────────────────────

# Puerto (la tienda, la API y el panel salen todos por acá).
PORT=4000

# Poné 1 si adelante hay un proxy que termina HTTPS (nginx, Caddy, Cloudflare,
# Railway, Render). Marca la cookie de sesión como Secure, así no viaja por
# HTTP en claro. En producción va en 1.
DETRAS_DE_TLS=0

# ── TLS ──────────────────────────────────────────────────────────────────
#
# Por omisión la conexión va cifrada y con verificación de certificado
# siempre que la base NO sea local. No hace falta tocar nada para Supabase.
#
# DB_SSL=0            apagarlo (sólo para una base local rara)
# DB_SSL=1            encenderlo contra localhost
# DB_SSL_CA=ruta.crt  CA propia, si el certificado no lo firma una pública.
#                     Si al conectar aparece "self-signed certificate in
#                     certificate chain", bajá el certificado desde el panel
#                     de Supabase (Settings → Database → SSL) y apuntá acá.

# ── Lo que NO hace falta ─────────────────────────────────────────────────
#
# No van ni SUPABASE_URL ni la anon key ni la service_role key. Esas son para
# hablarle a la API REST de Supabase (PostgREST) desde el navegador con
# supabase-js. Nuestro servidor se conecta directo a Postgres y nuestras
# tablas ni siquiera están en un esquema que PostgREST publique.

# Conexiones máximas del pool. 8 alcanza de sobra: la tienda no consulta la
# base, sólo el panel. Tené en cuenta que el oyente de LISTEN usa una conexión
# aparte, fuera de este número.
DB_POOL=8
