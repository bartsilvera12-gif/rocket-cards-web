# Copiá este archivo como .env y completá los valores.
# .env está en .gitignore: no se sube al repo ni se publica.

# Conexión a Postgres. La contraseña es la que le pusiste al rol con
#   ALTER ROLE rocketcards_app PASSWORD '...';
DATABASE_URL=postgres://rocketcards_app:LA-CONTRASENA@localhost:5432/rocketcards

# Puerto del servidor (la tienda, la API y el panel salen todos por acá).
PORT=4000

# Poné 1 si adelante hay un proxy que termina HTTPS (nginx, Caddy, Cloudflare).
# Marca la cookie de sesión como Secure, así no viaja por HTTP en claro.
DETRAS_DE_TLS=0

# Conexiones máximas del pool. 8 alcanza de sobra: la tienda no consulta la
# base, sólo el panel.
DB_POOL=8
